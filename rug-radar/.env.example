# Copy to .env and fill in. Never commit .env or real secrets.

# Public Solana RPC endpoint. Use any public/free RPC (no API key needed),
# e.g. https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: websocket endpoint for real-time launch discovery, if your RPC
# provider uses a different host for it than SOLANA_RPC_URL. Leave unset to
# derive it automatically (https -> wss, http -> ws) from SOLANA_RPC_URL.
#SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Port for the local web feed
PORT=8787
